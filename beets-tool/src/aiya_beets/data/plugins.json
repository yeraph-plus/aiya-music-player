{
  "schema": 1,
  "beets": {
    "min": "2.14.0",
    "max": "3.0.0"
  },
  "profiles": {
    "workbench": [
      "replaygain",
      "lyrics",
      "fromfilename",
      "duplicates",
      "scrub",
      "smartplaylist"
    ],
    "index": [
      "xtractor"
    ]
  },
  "plugins": [
    {
      "name": "replaygain",
      "title": "音量拉齐",
      "note": "提供 gain_db，引擎链路直接消费",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": ["ffmpeg"],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "lyrics",
      "title": "歌词抓取",
      "note": "抓取歌词，LRC 字段可直供",
      "builtin": true,
      "packages": ["beautifulsoup4>=4.12,<5"],
      "imports": ["bs4"],
      "exe": [],
      "writes": false,
      "network": true,
      "bundle": true
    },
    {
      "name": "fetchart",
      "title": "封面抓取",
      "note": "本地缺图时联网补封面（生成的 cover 落在专辑目录）",
      "builtin": true,
      "packages": [],
      "imports": ["requests"],
      "exe": [],
      "writes": true,
      "network": true,
      "bundle": true
    },
    {
      "name": "embedart",
      "title": "封面写进文件",
      "note": "把封面嵌进音频标签（改文件，索引家永不启用）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": ["ffmpeg"],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "scrub",
      "title": "脏标签清理",
      "note": "导入时清掉多余的标签键（改文件）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "fromfilename",
      "title": "文件名兜底",
      "note": "无标签文件按文件名猜字段",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": false,
      "network": false,
      "bundle": false
    },
    {
      "name": "duplicates",
      "title": "库内查重",
      "note": "维护四件套之一：找出重复条目",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": false,
      "network": false,
      "bundle": false
    },
    {
      "name": "smartplaylist",
      "title": "导出歌单",
      "note": "beets 查询导出 m3u，与推荐页衔接（在库目录写 .m3u）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "edit",
      "title": "外部编辑",
      "note": "用外部编辑器改标签并写回库",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "mbsync",
      "title": "MusicBrainz 同步",
      "note": "从 MusicBrainz 拉元数据补进库",
      "builtin": true,
      "packages": [],
      "imports": ["requests"],
      "exe": [],
      "writes": false,
      "network": true,
      "bundle": true
    },
    {
      "name": "chroma",
      "title": "音频指纹",
      "note": "acoustid 指纹识别（还需自备 fpcalc）",
      "builtin": true,
      "packages": ["pyacoustid>=1.3,<2"],
      "imports": ["acoustid"],
      "exe": ["fpcalc"],
      "writes": false,
      "network": true,
      "bundle": false,
      "indexForced": {
        "auto": "no"
      }
    },
    {
      "name": "convert",
      "title": "转码副本",
      "note": "给便携设备转一份低码率副本（产出新文件）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": ["ffmpeg"],
      "writes": true,
      "network": false,
      "bundle": false
    },
    {
      "name": "xtractor",
      "title": "音频特征",
      "note": "bpm / danceability / 情绪等（需要自备 Essentia 二进制）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": ["streaming_extractor_music"],
      "writes": true,
      "network": false,
      "bundle": false,
      "indexForced": {
        "auto": "no",
        "write": "no"
      }
    },
    {
      "name": "lastgenre",
      "title": "流派推断",
      "note": "按标签/联网推断流派（索引步骤不应因此变慢）",
      "builtin": true,
      "packages": [],
      "imports": [],
      "exe": [],
      "writes": false,
      "network": true,
      "bundle": false,
      "indexForced": {
        "auto": "no"
      }
    }
  ]
}
