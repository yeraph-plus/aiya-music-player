{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIYA Music",
  "version": "0.1.0",
  "identifier": "dev.aiya.music",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build && node tools/build-sidecar.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIYA Music",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aiya-audio-host"],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../licenses/THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../licenses/CARGO-DEPS.md": "licenses/CARGO-DEPS.md",
      "../licenses/SOURCE-OFFER.txt": "licenses/SOURCE-OFFER.txt"
    },
    "publisher": "AIYA Music",
    "copyright": "GPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "本地音乐播放器（Tauri + 原生 WASAPI 引擎）",
    "longDescription": "AIYA Music 是本地优先的桌面音乐播放器：原生 WASAPI 输出、Symphonia 解码、内建频谱与 EQ 链路，beets 负责标签写入与库对齐。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
