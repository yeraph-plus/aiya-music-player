# Rust
/target/
**/target/
*.pdb
*.ilk
# src-tauri 是 workspace member，cargo 只认根 Cargo.lock。它自己那份是
# Tauri CLI 旧行为留下的死文件——被忽略却不自知，只会慢慢腐烂成误导
# （2026-10-27 发现它停在 10-23，跟根差了 4 万字节）。
/src-tauri/Cargo.lock

# Node / Tauri
node_modules/
ui/dist/
ui/.vite/
src-tauri/gen/
src-tauri/target/
*.tsbuildinfo

# Playwright（E2E 产物）
ui/test-results/
ui/playwright-report/

# Local data / logs / caches
/data/
/backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log

# Python (beets-tool)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ts-rs 的默认导出目录：直接 `cargo test` 时会把类型写到各 crate 下，
# 那不是契约产物（真正入库的是 ui/src/lib/ipc/generated/，由 npm run gen:types 生成）
bindings/

# Vendored binaries (download scripts instead of committing)
/vendor/mpv/
/vendor/ffmpeg/
# externalBin 产物：由 tools/build-sidecar.mjs 现编现拷，不入库
/src-tauri/binaries/

# Fixtures: keep small manifests, ignore generated media
/fixtures/generated/
/fixtures/media/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local

# Secrets / signing
*.pfx
*.p12
.env
.env.*

# Dev-only：beets 工具的本地开发环境（体积大、可重建）
# 与 beets-tool/ 里自己那套 dev 数据放一起，不混进播放器的 tools/
beets-tool/.venv/
beets-tool/tests/fixtures/beets-home/
tools/.cache/

# beets 工具的构建产物：.pyz 约 33KB、套件包约 31MB（展开 112MB），
# 由 beets-tool/tools/build_*.py 现生成，不入库
beets-tool/dist/
# 自带的 embeddable 解释器（官方 zip 展开，约 12MB + 依赖）：build_bundle.py 现下
beets-tool/.runtime/
