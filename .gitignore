# Rust
/target/
**/target/
*.pdb
*.ilk

# Node / Tauri
node_modules/
ui/dist/
ui/.vite/
src-tauri/gen/
src-tauri/target/
*.tsbuildinfo

# Playwright（E2E 产物）
ui/test-results/
ui/playwright-report/

# Local data / logs / caches
/data/
/backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log

# Python (beets sidecar)
__pycache__/
*.py[cod]
.venv/
sidecars/beets/.beets/

# ts-rs 的默认导出目录：直接 `cargo test` 时会把类型写到各 crate 下，
# 那不是契约产物（真正入库的是 ui/src/lib/ipc/generated/，由 npm run gen:types 生成）
bindings/

# Vendored binaries (download scripts instead of committing)
/vendor/mpv/
/vendor/ffmpeg/
# externalBin 产物：由 tools/build-sidecar.mjs 现编现拷，不入库
/src-tauri/binaries/

# Fixtures: keep small manifests, ignore generated media
/fixtures/generated/
/fixtures/media/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local

# Secrets / signing
*.pfx
*.p12
.env
.env.*

# Dev-only beets 环境（体积大、可重建）
tools/beets-venv/
tools/beets-home/
# 随包 beets 运行时（embeddable Python + site-packages，约 100MB）：
# 由 node tools/pack-beets-runtime.mjs 生成，npm run bundle 会自动先跑它
tools/beets-runtime/
tools/.cache/
