{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "@aiya/contracts": ["./contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "contracts/**/*.ts"]
}
